<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Travesía</name>
  <id>org.inkscape.tutorial.generate_travesia_extension</id>
  <param name="angulo" type="float" gui-text="Angulo x10" default="7.0"/>
  <effect>
    <effects-menu>
      <submenu name="Generate"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">travesia.py</command>
  </script>
</inkscape-extension>

